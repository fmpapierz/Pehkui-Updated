{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"name": "${mod_name}",
	"version": "${mod_version}",
	"description": "${mod_description}",
	"authors":
	[
		"Virtuoel"
	],
	"contributors":
	[
		"Draylar",
		"haykam821",
		"Leximon",
		"MerchantPug",
		"TheGrimsey"
	],
	"contact":
	{
		"homepage": "${homepage_url}",
		"issues": "${issues_url}",
		"sources": "${sources_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/pehkui/icon.png",
	"environment": "*",
	"depends":
	{
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api-base": "*",
		"fabric-command-api-v2": "*",
		"fabric-networking-api-v1": "*",
		"fabric-registry-sync-v0": "*",
		"fabric-resource-loader-v0": "*"
	},
	"entrypoints":
	{
		"main":
		[
			"virtuoel.pehkui.fabric.PehkuiFabric"
		],
		"client":
		[
			"virtuoel.pehkui.fabric.PehkuiFabricClient"
		],
		"modmenu":
		[
			"virtuoel.pehkui.fabric.PehkuiModMenu"
		]
	},
	"mixins":
	[
		"pehkui.mixins.json"
	],
	"custom":
	{
		"modmenu":
		{
			"links":
			{
				"modmenu.homepage": "${homepage_url}",
				"modmenu.issues": "${issues_url}",
				"modmenu.sources": "${sources_url}"
			}
		}
	}
}
